Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:config|data|scripts|tools|outputs)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:fixnear_db\.sql|start_server\.bat|Pasted%20text\.txt)$ - [F,L,NC]
</IfModule>

<FilesMatch "(^\.|\.(?:sql|log|ini|env|bak|dist|md)$)">
    Require all denied
</FilesMatch>

<Files "install.php">
    Require local
</Files>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>
